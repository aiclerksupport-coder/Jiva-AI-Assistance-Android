GOOGLE_CLOUD_PROJECT=your-firebase-project-id
# Server only: Google Cloud Secret Manager. NEVER pass Gemini keys to Android/Flutter.
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=models/gemini-3.8-live
# Comma-separated App Check app IDs from Firebase Console; NOT Android package names.
# Must include the registered native Android and Flutter Android app IDs.
JIVA_ALLOWED_APP_IDS=1:123456:android:example1,1:123456:android:example2
PORT=8080
